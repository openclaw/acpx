{
  "id": "acp.v1.session.prompt.structured_blocks",
  "profile": "acp-core-v1",
  "title": "Baseline structured prompt content is accepted",
  "description": "Verify text and resource links complete without requiring optional prompt capabilities.",
  "steps": [
    {
      "action": "new_session",
      "save_as": "session_id"
    },
    {
      "action": "prompt",
      "session": "$session_id",
      "prompt": [
        {
          "type": "text",
          "text": "Acknowledge these content blocks without opening the linked resource."
        },
        {
          "type": "resource_link",
          "uri": "file:///tmp/conformance-resource.txt",
          "name": "conformance-resource.txt"
        }
      ],
      "save_as": "inspect_prompt_result"
    }
  ],
  "checks": [
    {
      "type": "saved_stop_reason_in",
      "key": "inspect_prompt_result",
      "values": ["end_turn", "completed", "done"]
    },
    {
      "type": "updates_count_at_least",
      "min": 1
    },
    {
      "type": "updates_all_session",
      "session": "$session_id"
    }
  ],
  "timeouts": {
    "request_timeout_ms": 10000,
    "update_timeout_ms": 30000
  }
}
